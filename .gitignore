### Flix ###
# Ignore Flix build artifacts
*.fpkg
.GITHUB_TOKEN
artifact/
build/
lib/
crash_report_*.txt

### Java ###
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.vsix

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

### Kotlin ###
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# The Gradle wrapper jar is meant to be committed (it's what lets ./gradlew run without
# a system Gradle install) -- placed after the *.jar rules above (both the Java and Kotlin
# sections have one; gitignore is last-match-wins, so this must come after both).
!**/gradle/wrapper/gradle-wrapper.jar

### Scala ###
.metals/

### Gradle (jetbrains-plugin/) ###
.gradle/
.intellijPlatform/
.kotlin/

### IntelliJ IDEA ###
.idea/
*.iml

