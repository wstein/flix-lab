{
    "name": "flix-debug",
    "displayName": "Flix Debug (minimal)",
    "description": "Attach a debugger to a running Flix program built with --Xdebug (wstein/flix-fork) and set breakpoints directly in .flix files.",
    "version": "0.0.1",
    "publisher": "wstein",
    "private": true,
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Debuggers"
    ],
    "contributes": {
        "breakpoints": [
            {
                "language": "flix"
            }
        ],
        "debuggers": [
            {
                "type": "flix",
                "label": "Flix",
                "languages": [
                    "flix"
                ],
                "program": "./bin/flix-debug-adapter",
                "configurationAttributes": {
                    "attach": {
                        "properties": {
                            "hostName": {
                                "type": "string",
                                "description": "JDWP host to attach to.",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "JDWP port to attach to.",
                                "default": 5005
                            }
                        }
                    },
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the .flix file or project directory to run.",
                                "default": "${file}"
                            },
                            "entryPoint": {
                                "type": "string",
                                "description": "Flix --entrypoint to run, if not the default main()."
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory to run flix in (defaults to the nearest flix.toml directory above 'program')."
                            },
                            "flixCommand": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Command used to invoke flix (defaults to [\"flix\"]; e.g. [\"${workspaceFolder}/scripts/flix-fork\"] for this project's --Xdebug fork build)."
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Extra arguments passed to the running Flix program."
                            }
                        }
                    }
                }
            }
        ]
    }
}
